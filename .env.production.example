# Production Environment Variables for Railway
# Copy these to your Railway project's environment variables section

# === REQUIRED VARIABLES ===

# Momence API Configuration
MOMENCE_ALL_COOKIES=your_momence_cookies
MOMENCE_HOST_ID=your_momence_host_id
REFERRAL_MEMBERSHIP_ID=your_referral_membership_id
ELIGIBILITY_MEMBERSHIP_ID=263860

# Additional hosts
# Host 33905 is included by default:
# - Reward membership ID: 583036
# - Eligibility membership ID: 583037
# Optional comma-separated list if you need to include more hosts with the default membership settings.
MOMENCE_HOST_IDS=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_TABLE=referral_rewards

# === OPTIONAL VARIABLES ===

# Scheduling (default: daily at 10 PM IST)
CRON_SCHEDULE=30 16 * * *

# Logging
LOG_LEVEL=info
NODE_ENV=production

# Webhook for error notifications (optional)
WEBHOOK_URL=

# Railway will automatically set this
PORT=3000
